+	zfs_exit(zfsvfs, FTAG);
+	entered = B_FALSE;
+	if ((error = vn_lock(ZTOV(zp), LK_SHARED | LK_RETRY)) != 0)
+		goto out;
+	locked = B_TRUE;
+	if ((error = zfs_enter_verify_zp(zfsvfs, zp, FTAG)) != 0)
+		goto out;
+	entered = B_TRUE;
+	if ((error = cd_native_identity_check(zp, &id)) != 0)
+		goto out;
